{
    "name": "brightbulb/laravel-uptime-agent",
    "description": "Lightweight, token-protected health endpoint for the Brightbulb uptime dashboard.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Brightbulb\\UptimeAgent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Brightbulb\\UptimeAgent\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Brightbulb\\UptimeAgent\\UptimeAgentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
